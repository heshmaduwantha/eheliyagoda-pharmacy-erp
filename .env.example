# Publicly safe application identity (NEXT_PUBLIC_* values may reach the browser).
NODE_ENV="development"
APP_ENV="development"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_NAME="Eheliyagoda Pharmacy ERP"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Colombo"

# PostgreSQL. Use Neon pooled DATABASE_URL at runtime and DIRECT_URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional supporting cache. Redis is never the ERP source of truth.
REDIS_URL="rediss://default:TOKEN@HOST:PORT"

# Required server-only session signing secret (minimum 32 characters).
AUTH_SECRET="replace-with-a-long-random-secret"

# UAT safeguards. Never set these for production.
UAT_MODE="false"
UAT_ADMIN_USERNAME="uat-owner"
UAT_ADMIN_PASSWORD="set-in-provider-dashboard-only"
UAT_PHARMACIST_USERNAME="uat-pharmacist"
UAT_PHARMACIST_PASSWORD="set-in-provider-dashboard-only"
UAT_ALLOW_DEMO_RESET="false"

# Optional diagnostics; disable detailed timing in hosted UAT.
PERF_LOGGING="0"

# R2 is not yet consumed by this repository because prescription upload is not implemented.
# Keep these server-only when the upload module is introduced.
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="eheliyagoda-pharmacy-uat"
S3_ACCESS_KEY_ID="set-in-provider-dashboard-only"
S3_SECRET_ACCESS_KEY="set-in-provider-dashboard-only"
S3_FORCE_PATH_STYLE="true"
