generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String     @id @default(uuid()) @db.Uuid
  roleId                        String     @db.Uuid
  role                          Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  name                          String     @db.VarChar(160)
  username                      String     @unique @db.VarChar(80)
  passwordHash                  String     @db.VarChar(255)
  phone                         String?    @db.VarChar(40)
  isActive                      Boolean    @default(true)
  pharmacistRegistrationRef     String?    @db.VarChar(120)
  pharmacistCertificateFileUrl  String?    @db.VarChar(2048)
  pharmacistCertificateVerified Boolean    @default(false)
  auditLogs                     AuditLog[] @relation("AuditActor")
  sales                         Sale[]     @relation("SaleCashier")
  saleVoids                     SaleVoid[] @relation("SaleVoidActor")
  expenses                      Expense[]  @relation("ExpenseCreatedBy")
  supplierPayments              SupplierPayment[] @relation("SupplierPaymentCreatedBy")
  capturedPrescriptions         Prescription[] @relation("PrescriptionCapturedBy")
  createdAt                     DateTime   @default(now())
  updatedAt                     DateTime   @updatedAt

  @@index([roleId])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(80)
  name            String           @db.VarChar(120)
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(100)
  description     String?          @db.VarChar(255)
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(100)
  beforeData  Json?
  afterData   Json?
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(512)
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Catalog (Milestone 3)
// ---------------------------------------------------------------------------

enum ProductType {
  MEDICINE
  GENERAL_ITEM
}

enum PrescriptionRule {
  NONE
  PROMPT_SKIPPABLE
  HARD_REQUIRED_CONTROLLED
}

model Product {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String           @db.VarChar(200)
  genericName         String?          @db.VarChar(200)
  strength            String?          @db.VarChar(80)
  form                String?          @db.VarChar(80)
  productType         ProductType
  category            String?          @db.VarChar(120)
  baseUnitName        String           @db.VarChar(60)
  prescriptionRule    PrescriptionRule @default(NONE)
  isControlled        Boolean          @default(false)
  isSpecialDrug       Boolean          @default(false)
  reorderLevel        Decimal          @default(0) @db.Decimal(14, 3)
  reorderQty          Decimal          @default(0) @db.Decimal(14, 3)
  defaultSellingPrice Decimal?         @db.Decimal(12, 2)
  isActive            Boolean          @default(true)
  units               ProductUnit[]
  barcodes            ProductBarcode[]
  batches             Batch[]
  grnLines            GrnLine[]
  stockMovements      StockMovement[]
  saleLines           SaleLine[]
  prescriptionSaleLines PrescriptionSaleLine[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([productType, isActive])
  @@index([name])
}

model ProductUnit {
  id                String           @id @default(uuid()) @db.Uuid
  productId         String           @db.Uuid
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitName          String           @db.VarChar(60)
  factorToBase      Decimal          @db.Decimal(14, 3)
  isPurchaseDefault Boolean          @default(false)
  isSaleDefault     Boolean          @default(false)
  barcodes          ProductBarcode[]
  grnLines          GrnLine[]
  saleLines         SaleLine[]
  createdAt         DateTime         @default(now())

  @@unique([productId, unitName])
  @@index([productId])
}

model ProductBarcode {
  id          String       @id @default(uuid()) @db.Uuid
  productId   String       @db.Uuid
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId      String?      @db.Uuid
  unit        ProductUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  barcode     String       @unique @db.VarChar(120)
  barcodeType String       @default("MANUFACTURER") @db.VarChar(40)
  isPrimary   Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Procurement (Milestone 4)
// ---------------------------------------------------------------------------

enum GrnStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SupplierInvoiceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Supplier {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @db.VarChar(200)
  contactPerson   String?           @db.VarChar(160)
  phone           String?           @db.VarChar(40)
  email           String?           @db.VarChar(160)
  address         String?           @db.VarChar(400)
  creditTermDays  Int               @default(0)
  isActive        Boolean           @default(true)
  grns            Grn[]
  invoices        SupplierInvoice[]
  payments        SupplierPayment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([isActive])
  @@index([name])
}

model Grn {
  id               String           @id @default(uuid()) @db.Uuid
  grnNo            String           @unique @db.VarChar(60)
  supplierId       String           @db.Uuid
  supplier         Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierInvoiceNo String?         @db.VarChar(80)
  invoiceTotal     Decimal          @default(0) @db.Decimal(12, 2)
  status           GrnStatus        @default(DRAFT)
  notes            String?          @db.VarChar(500)
  receivedById     String?          @db.Uuid
  receivedAt       DateTime?
  lines            GrnLine[]
  invoice          SupplierInvoice?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([supplierId, createdAt])
  @@index([status])
}

model GrnLine {
  id            String      @id @default(uuid()) @db.Uuid
  grnId         String      @db.Uuid
  grn           Grn         @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productId     String      @db.Uuid
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitId        String      @db.Uuid
  unit          ProductUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  qtyInUnit     Decimal     @db.Decimal(14, 3)
  qtyBase       Decimal     @db.Decimal(14, 3)
  batchNo       String?     @db.VarChar(80)
  expiryDate    DateTime?   @db.Date
  mrp           Decimal?    @db.Decimal(12, 2)
  costPrice     Decimal     @db.Decimal(12, 2)
  sellingPrice  Decimal     @db.Decimal(12, 2)
  batch         Batch?
  createdAt     DateTime    @default(now())

  @@index([grnId])
}

model SupplierInvoice {
  id          String                @id @default(uuid()) @db.Uuid
  supplierId  String                @db.Uuid
  supplier    Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  grnId       String?               @unique @db.Uuid
  grn         Grn?                  @relation(fields: [grnId], references: [id], onDelete: SetNull)
  invoiceNo   String?               @db.VarChar(80)
  totalAmount Decimal               @db.Decimal(12, 2)
  paidAmount  Decimal               @default(0) @db.Decimal(12, 2)
  status      SupplierInvoiceStatus @default(OPEN)
  dueDate     DateTime?             @db.Date
  payments    SupplierPayment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([supplierId, status])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Inventory (batch + ledger created by GRN confirm; full FEFO in Milestone 5)
// ---------------------------------------------------------------------------

enum BatchStatus {
  ACTIVE
  QUARANTINED
  DEPLETED
}

enum StockMovementType {
  GRN_IN
  SALE_OUT
  RETURN_IN
  WRITE_OFF
  ADJUSTMENT
}

model Batch {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @db.Uuid
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  grnLineId      String?         @unique @db.Uuid
  grnLine        GrnLine?        @relation(fields: [grnLineId], references: [id], onDelete: SetNull)
  batchNo        String?         @db.VarChar(80)
  expiryDate     DateTime?       @db.Date
  mrp            Decimal?        @db.Decimal(12, 2)
  costPrice      Decimal         @db.Decimal(12, 2)
  sellingPrice   Decimal         @db.Decimal(12, 2)
  qtyOnHandBase  Decimal         @default(0) @db.Decimal(14, 3)
  status         BatchStatus     @default(ACTIVE)
  stockMovements StockMovement[]
  saleLines      SaleLine[]
  prescriptionSaleLines PrescriptionSaleLine[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([productId, status, expiryDate])
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  productId    String            @db.Uuid
  product      Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId      String            @db.Uuid
  batch        Batch             @relation(fields: [batchId], references: [id], onDelete: Restrict)
  movementType StockMovementType
  qtyBase      Decimal           @db.Decimal(14, 3)
  refType      String            @db.VarChar(40)
  refId        String            @db.VarChar(60)
  note         String?           @db.VarChar(400)
  createdById  String?           @db.Uuid
  createdAt    DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Sales (Milestone 9)
// ---------------------------------------------------------------------------

enum SaleStatus {
  HELD
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
}

model Sale {
  id              String      @id @default(uuid()) @db.Uuid
  saleNumber      String      @unique @db.VarChar(60)
  clientRequestId String?     @unique @db.Uuid
  status          SaleStatus  @default(HELD)
  cashierId       String      @db.Uuid
  cashier         User        @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  prescription    Prescription?
  subtotal        Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @default(0) @db.Decimal(12, 2)
  notes           String?     @db.VarChar(500)
  completedAt     DateTime?
  voidedAt        DateTime?
  lines           SaleLine[]
  payments        SalePayment[]
  voidRecord      SaleVoid?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, completedAt])
  @@index([cashierId, createdAt])
}

model SaleLine {
  id                  String                @id @default(uuid()) @db.Uuid
  saleId              String                @db.Uuid
  sale                Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  clientLineId        String?               @db.VarChar(120)
  productId           String                @db.Uuid
  product             Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId             String                @db.Uuid
  batch               Batch                 @relation(fields: [batchId], references: [id], onDelete: Restrict)
  unitId              String                @db.Uuid
  unit                ProductUnit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  qty                 Decimal               @db.Decimal(14, 3)
  qtyBase             Decimal               @db.Decimal(14, 3)
  unitPrice           Decimal               @db.Decimal(12, 2)
  lineTotal           Decimal               @db.Decimal(12, 2)
  discountAmount      Decimal               @default(0) @db.Decimal(12, 2)
  costPriceAtSale     Decimal               @db.Decimal(12, 2)
  mrpAtSale           Decimal?              @db.Decimal(12, 2)
  barcodeUsed         String?               @db.VarChar(120)
  productNameSnapshot String                @db.VarChar(200)
  batchNoSnapshot     String?               @db.VarChar(80)
  expiryDateSnapshot  DateTime?             @db.Date
  prescriptionSaleLine PrescriptionSaleLine?
  createdAt           DateTime              @default(now())

  @@index([saleId])
  @@index([productId])
  @@index([batchId])
  @@index([saleId, productId])
}

model SalePayment {
  id             String        @id @default(uuid()) @db.Uuid
  saleId         String        @db.Uuid
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  cardReference  String?       @db.VarChar(120)
  createdAt      DateTime      @default(now())

  @@index([saleId])
  @@index([method])
}

enum SaleVoidStockPolicy {
  NO_STOCK_RETURN
  RETURN_TO_ACTIVE
}

model SaleVoid {
  id              String             @id @default(uuid()) @db.Uuid
  saleId          String             @unique @db.Uuid
  sale            Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  reason          String             @db.VarChar(500)
  refundAmount    Decimal            @db.Decimal(12, 2)
  refundMethod    PaymentMethod?
  refundReference String?            @db.VarChar(120)
  stockPolicy     SaleVoidStockPolicy @default(NO_STOCK_RETURN)
  voidedById      String             @db.Uuid
  voidedBy        User               @relation("SaleVoidActor", fields: [voidedById], references: [id], onDelete: Restrict)
  voidedAt        DateTime           @default(now())
  createdAt       DateTime           @default(now())

  @@index([voidedAt])
  @@index([voidedById])
}

// ---------------------------------------------------------------------------
// Operational finance (Milestone 10)
// ---------------------------------------------------------------------------

enum ExpenseCategory {
  RENT
  ELECTRICITY
  WATER
  SALARY
  TRANSPORT
  INTERNET
  STATIONERY
  BANK_CHARGES
  MAINTENANCE
  OTHER
}

model Expense {
  id            String          @id @default(uuid()) @db.Uuid
  expenseNumber String          @unique @db.VarChar(60)
  date          DateTime        @db.Date
  category      ExpenseCategory
  description   String?         @db.VarChar(255)
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  reference     String?         @db.VarChar(120)
  notes         String?         @db.VarChar(500)
  createdById   String          @db.Uuid
  createdBy     User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@index([category])
  @@index([createdById, date])
}

model SupplierPayment {
  id                String          @id @default(uuid()) @db.Uuid
  paymentNumber     String          @unique @db.VarChar(60)
  supplierInvoiceId String          @db.Uuid
  supplierInvoice   SupplierInvoice  @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)
  supplierId       String          @db.Uuid
  supplier         Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  amount           Decimal         @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  reference        String?         @db.VarChar(120)
  paidAt           DateTime        @default(now())
  notes            String?         @db.VarChar(500)
  createdById      String          @db.Uuid
  createdBy        User            @relation("SupplierPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([supplierInvoiceId])
  @@index([supplierId])
  @@index([paidAt])
  @@index([supplierId, paidAt])
}

// ---------------------------------------------------------------------------
// Prescription and controlled-drug capture (Milestone 7)
// Sale and SaleLine were introduced in Milestone 9. Prescription rows now link
// directly to the authoritative completed sale record.
// ---------------------------------------------------------------------------

model Patient {
  id               String         @id @default(uuid()) @db.Uuid
  name             String         @db.VarChar(200)
  phone            String?        @db.VarChar(40)
  nic              String?        @db.VarChar(80)
  patientReference String?        @db.VarChar(120)
  age              Int?
  prescriptions    Prescription[]
  createdAt        DateTime       @default(now())

  @@index([phone])
  @@index([nic])
  @@index([patientReference])
}

model Prescription {
  id           String                 @id @default(uuid()) @db.Uuid
  saleId       String                 @unique @db.Uuid
  sale         Sale                   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  patientId    String?                @db.Uuid
  patient      Patient?               @relation(fields: [patientId], references: [id], onDelete: SetNull)
  prescriberName String?              @db.VarChar(200)
  prescriberRef  String?              @db.VarChar(120)
  imageKey     String?                @db.VarChar(2048)
  skipReason   String?                @db.VarChar(500)
  capturedById String?                @db.Uuid
  capturedBy   User?                  @relation("PrescriptionCapturedBy", fields: [capturedById], references: [id], onDelete: SetNull)
  capturedAt   DateTime               @default(now())
  saleLines    PrescriptionSaleLine[]

  @@index([patientId])
  @@index([capturedById])
}

model PrescriptionSaleLine {
  id             String       @id @default(uuid()) @db.Uuid
  prescriptionId String       @db.Uuid
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  saleLineId     String       @db.Uuid
  saleLine       SaleLine     @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  productId      String       @db.Uuid
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchId        String       @db.Uuid
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  qtyBase        Decimal      @db.Decimal(14, 3)
  createdAt      DateTime     @default(now())

  @@unique([saleLineId])
  @@index([prescriptionId])
  @@index([productId])
  @@index([batchId])
}
